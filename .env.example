# 复制为 .env 并填上你的值：cp .env.example .env

# 面板登录密码（必填）。未设置时面板不要求密码，仅建议内网使用。
ADMIN_PASSWORD=your-password-here

# 出口代理订阅地址（可选）。机场 clash/v2ray 订阅 URL，支持 base64 / yaml。
# 配置后，所有上游请求（session/chat 等）都经订阅里的节点出站，用于换 IP。
# 留空则直连。
SUBSCRIPTION_URL=

# 面板 API Key（可选）。不设则首次启动自动生成并持久化到数据目录。
# FREEBUFF_API_KEY=

# 数据目录（账号池、API Key、模型映射、mihomo 缓存）。容器里默认 /data（挂载卷），
# 本地开发默认 ./data。一般不用改。
# FREEBUFF_DATA_DIR=/data
# FREEBUFF_ACCOUNT_STATE_FILE=/data/credentials/account-state.json

# 账号池 token（可选，多账号逗号分隔；也可以在面板里添加）。
# FREEBUFF_TOKEN=

# 上游 API 地址（一般不用改）。
# CODEBUFF_API=https://www.codebuff.com

# 账号池只读（true=禁止面板改账号）。
# FREEBUFF_READONLY=false

# 同一账号的 session 正忙时最多等它释放多久（毫秒，默认 120000）。免费额度按账号计
# 且每天只有个位数，等原账号比换号新建 session 省额度。设 0 = 忙时立刻换号。
# FREEBUFF_SESSION_WAIT_MS=120000
